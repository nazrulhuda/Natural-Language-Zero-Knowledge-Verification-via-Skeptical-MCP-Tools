# Copy to .env and fill in. Never commit .env (it is gitignored).

# API key for the OpenAI-compatible LLM endpoint below.
DEEPINFRA_API_KEY=your_key_here

# Any OpenAI-compatible endpoint. The reported runs used DeepInfra; development
# before the cross-model runs used Groq. The evaluation runner records this value
# in every result record it writes.
LLM_BASE_URL=https://api.deepinfra.com/v1/openai

# Model identifier. The identifiers used in the paper's runs (from eval/run_verify_all.sh):
#   Qwen/Qwen3-32B
#   mistralai/Mistral-Small-3.2-24B-Instruct-2506
#   meta-llama/Meta-Llama-3-8B-Instruct
# The Qwen 2.5 72B and Qwen 3 235B Config B runs did not have their identifiers recorded.
LLM_MODEL=Qwen/Qwen3-32B

# Ablation configuration: A, B, C, D or A_STAR. Must match on backend and proverserver.
CONFIG=C

# Adds a tool_calls log to every /get response (required by the evaluation runner).
EVAL_MODE=true

# Flask session signing key. Change for any deployment that is reachable over a network.
SECRET_KEY=change-me-in-production

# Optional
# ADMIN_SYNC_SECRET=            # protects /admin/sync-dataset when set
# DATASET_DEFAULT_PASSWORD=password123   # shared password for the synthetic dataset users
