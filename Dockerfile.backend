FROM python:3.13-slim

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY app.py .
COPY context_manager.py .
COPY account_store.py .
COPY dataset_sync.py .
COPY templates/ templates/
COPY static/ static/

# Ensure data directory for input zips exists
RUN mkdir -p /app/data/input_zips

# Expose port
EXPOSE 5001

# Set environment variables
ENV FLASK_PORT=5001

# Run the application
CMD ["python", "app.py"]

